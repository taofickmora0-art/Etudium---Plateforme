# Copiez ce fichier en .env.local et remplissez-le avec les valeurs du projet Supabase etudium-dev
# (Project Settings > API). Seulement la clé PUBLIQUE (publishable ou anon), jamais la clé secrète.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Modération automatique des publications (migration 0020, guide « Ce qui te revient », section 25).
# Lues par le serveur seulement : jamais de préfixe NEXT_PUBLIC_, jamais dans le dépôt.
# Clé de l'API d'Anthropic (console.anthropic.com > API Keys).
ANTHROPIC_API_KEY=
# Jeton de modération : select jeton from public.reglages_moderation; dans l'éditeur SQL de Supabase.
MODERATION_JETON=
# Modèle de l'analyse (facultatif) :
# MODERATION_MODELE=claude-haiku-5-5

# Abonnements et paiement Payiz (lot 2, migrations 0049 à 0052, guide « Ce qui te revient », section 56).
# Lues par le serveur seulement : jamais de préfixe NEXT_PUBLIC_, jamais dans le dépôt.
# Clé secrète Payiz (sk_test_… en test, sk_live_… en réel). Elle suffit : le jeton du serveur en est tiré.
PAYIZ_CLE_SECRETE=
# Secret des notifications signées (Payiz > Développeurs > Webhooks), une fois le site en ligne.
PAYIZ_SECRET_WEBHOOK=
